DATABASE_URL=postgres://localhost:5432/sitepulse?sslmode=disable
PORT=8080
APP_BASE_URL=http://localhost:3000
APP_ENV=development
API_INTERNAL_URL=http://127.0.0.1:8080
NEXT_PUBLIC_APP_ENV=development

# Optional. Without these keys the audit still runs.
# PageSpeed scores stay "Not available" instead of being invented.
PAGESPEED_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AI_MONTHLY_TOKEN_CAP=200000

# Waffo Pancake. Copy WAFFO_* into apps/web/.env.local as well.
# Checkout stays disabled until WAFFO_PRIVATE_KEY and WAFFO_PRO_PRODUCT_ID are set.
WAFFO_MERCHANT_ID=MER_5ooHoLDs8e6BiJuoNToKys
